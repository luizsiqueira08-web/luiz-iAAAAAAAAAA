/* ==========================================
   ESTILOS GERAIS - TEMA PRETO E BRANCO
   ========================================== */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: #0d0d0d;
  color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 20px;
}

/* ==========================================
   CONTAINER E TELAS
   ========================================== */

.container {
  background-color: #1a1a1a;
  border: 2px solid #ffffff;
  border-radius: 8px;
  width: 100%;
  max-width: 600px;
  padding: 30px;
  box-shadow: 0 10px 30px rgba(255, 255, 255, 0.05);
  text-align: center;
}

h1 {
  font-size: 2.2rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 10px;
  border-bottom: 1px solid #333333;
  padding-bottom: 15px;
}

p {
  color: #cccccc;
  font-size: 1.1rem;
  margin-bottom: 25px;
  line-height: 1.5;
}

.screen {
  display: none;
}

.screen.active {
  display: block;
}

/* ==========================================
   BOTÕES E OPÇÕES DO QUIZ
   ========================================== */

.btn {
  background-color: #ffffff;
  color: #000000;
  border: 2px solid #ffffff;
  padding: 12px 28px;
  font-size: 1rem;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 1px;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
  border-radius: 4px;
  margin-top: 15px;
}

.btn:hover {
  background-color: #000000;
  color: #ffffff;
}

.options-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 20px;
}

.option-btn {
  background-color: #111111;
  color: #ffffff;
  border: 1px solid #444444;
  padding: 14px 18px;
  text-align: left;
  font-size: 1rem;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.option-btn:hover {
  background-color: #ffffff;
  color: #000000;
  border-color: #ffffff;
}

/* Estado da resposta correta */
.option-btn.correct {
  background-color: #ffffff !important;
  color: #000000 !important;
  border-color: #ffffff !important;
  font-weight: bold;
}

/* Estado da resposta incorreta */
.option-btn.wrong {
  background-color: #333333 !important;
  color: #777777 !important;
  border-color: #333333 !important;
  text-decoration: line-through;
}

/* ==========================================
   PROGRESSO E PONTUAÇÃO FINAL
   ========================================== */

.progress {
  font-size: 0.9rem;
  color: #888888;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 15px;
}

.score-display {
  font-size: 3rem;
  font-weight: bold;
  margin: 20px 0;
  letter-spacing: 2px;
}